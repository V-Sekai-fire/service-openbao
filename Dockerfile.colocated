# Bao on the weftspun-fdb machines (RFD 2147), layered on the running colocated image, which
# carries the FDB server and the Bao binaries and plugins with their catalog hashes.
ARG BASE_IMAGE=registry.fly.io/weftspun-fdb:colocated-20261013204638
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends socat && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
COPY base-colocated.hcl /bao/config/base.hcl
COPY colocated-entrypoint.sh /usr/local/bin/colocated-entrypoint.sh
RUN chmod +x /usr/local/bin/colocated-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/colocated-entrypoint.sh"]
